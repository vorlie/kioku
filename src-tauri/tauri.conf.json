{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kioku",
  "version": "0.2.0",
  "identifier": "com.kioku.vorlie",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Kioku",
        "decorations": true,
        "transparent": false,
        "width": 1597,
        "height": 867,
        "minWidth": 1470,
        "minHeight": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/linux/kioku-for-anilist.desktop"
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/kioku-for-anilist.desktop"
      }
    }
  }
}
